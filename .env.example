# Copy to .env.local and fill in. Never commit real values.

# NextAuth
NEXTAUTH_URL=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_ID=
GOOGLE_SECRET=

# MongoDB connection string used by Prisma (prisma/schema.prisma)
MONGODB_URI=

# LeaseGuard FastAPI backend, e.g. https://<droplet-ip>.sslip.io (no trailing slash)
BACKEND_URL=
# Shared secret sent as X-API-Key; must match BACKEND_API_KEY in backend/.env
BACKEND_API_KEY=

# Stripe (optional)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mailgun (optional)
MAILGUN_API_KEY=

# Demo only: open the dashboard without Google sign-in (anyone with the URL can pause/resume GPUs)
AUTH_DISABLED=
