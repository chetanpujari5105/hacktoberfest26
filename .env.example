# Copy to .env.local and fill in values. Never commit real values.

# --- NextAuth / Google OAuth / database (existing starter vars) ---
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
MONGODB_URI=

# --- LeaseGuard BFF (server-only; never prefix with NEXT_PUBLIC_) ---
# Base URL of Pranav's FastAPI service, e.g. the internal host:port (no trailing slash)
BACKEND_URL=
# Shared key sent as the X-API-Key header from the Next.js server to FastAPI
BACKEND_API_KEY=
# "true" serves clearly-labelled in-memory sample data instead of calling FastAPI
DEMO_MODE=false

# Demo only: open the dashboard without Google sign-in (anyone with the URL can pause/resume GPUs)
AUTH_DISABLED=
