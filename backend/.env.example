# ── Provider ───────────────────────────────────────────────────────────
# fake = scripted demo (no GPU, no credits); jarvislabs = real instances
PROVIDER=fake
# Jarvislabs API token (also used for the Gemma serverless endpoint)
JL_API_KEY=
# Fake provider scenarios per machine id: converge | oom | stall | healthy
FAKE_SCENARIOS=101=converge,102=oom,103=stall

# Files demo/train.py writes on the GPU box
TRAIN_LOG=~/train.log
TRAIN_PID=~/train.pid
CKPT_FLAG=~/ckpt.flag
CKPT_DONE=~/ckpt.done

# ── Gemma 4 judge ──────────────────────────────────────────────────────
# remote = Jarvislabs Model APIs (pay per token), local = Ollama, off = rules only
LLM=remote
# Jarvislabs Model APIs (OpenAI-compatible); a self-hosted serverless URL also works
LLM_BASE_URL=https://models.jarvislabs.net/v1
# Defaults to JL_API_KEY when empty
LLM_API_KEY=
# gemma-4-31b-it or the cheaper gemma-4-26b-a4b-it
LLM_MODEL=gemma-4-31b-it
# Docker on Mac/Windows: http://host.docker.internal:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b

# ── Temporal ───────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Temporal Cloud only
TEMPORAL_API_KEY=
TASK_QUEUE=leaseguard

# ── Telegram (separate bot from Kepler's) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
# Group shared with Kepler's bot, e.g. -1001234567890
TELEGRAM_GROUP_ID=

# ── API ────────────────────────────────────────────────────────────────
# Shared secret with Next.js (BACKEND_API_KEY) and the Kepler plugin (LEASEGUARD_API_KEY)
# Generate: openssl rand -hex 32
BACKEND_API_KEY=
# A30 on-demand rate; savings are computed from this unless a run sets its own
DEFAULT_HOURLY_COST_INR=38.88
# Guard timing; use PROBE_INTERVAL_S=5 and DECISION_TIMEOUT_S=60 for demos
PROBE_INTERVAL_S=60
DECISION_TIMEOUT_S=600
# <droplet-ip>.sslip.io for Caddy's automatic HTTPS
PUBLIC_HOST=localhost

# ── Wallet guard ───────────────────────────────────────────────────────
# In INR, the Jarvislabs wallet currency
WALLET_WARN_INR=800
WALLET_CRITICAL_INR=250
WALLET_INTERVAL_S=600

# Seconds per dashboard "minute" (5 = fast demo, 60 = real time)
POLICY_SECONDS_PER_MINUTE=60
